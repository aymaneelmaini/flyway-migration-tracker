<idea-plugin>
    <id>com.aymaneelmaini.flyway-version-tracker</id>
    <name>Flyway Version Tracker</name>
    <vendor url="https://github.com/aymaneelmaini">Aymane El Maini</vendor>

    <description><![CDATA[
        Prevents Flyway migration version conflicts by checking local and remote branches.<br/>
        <ul>
            <li>Auto-suggests the next safe migration version when creating a new file</li>
            <li>Blocks commits that introduce duplicate migration versions</li>
            <li>Warns in the push dialog if local migrations conflict with the remote branch</li>
            <li>Sidebar panel showing local vs remote migrations with conflict highlights</li>
        </ul>
        <b>Usage:</b> Right-click your migrations folder → <i>Mark as Migrations Root</i>, then configure the sync branch via <i>Tools → Flyway Tracker → Configure Sync Branch</i>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">

        <notificationGroup id="Flyway Version Tracker"
                           displayType="BALLOON"/>

        <projectService serviceImplementation="com.aymaneelmaini.flywaytracker.settings.ProjectSettings"/>
        <projectService serviceImplementation="com.aymaneelmaini.flywaytracker.services.FlywayMigrationService"/>

        <toolWindow id="Flyway Tracker"
                    anchor="right"
                    factoryClass="com.aymaneelmaini.flywaytracker.toolwindow.MigrationTrackerToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowDatabase"/>

        <projectActivity implementation="com.aymaneelmaini.flywaytracker.startup.FlywayTrackerStartupActivity"/>

        <checkinHandlerFactory implementation="com.aymaneelmaini.flywaytracker.checkin.MigrationVersionCheckinHandlerFactory"/>


    </extensions>

    <actions>

        <!-- New Migration: appears under New File menu -->
        <action id="flyway.tracker.createMigration"
                class="com.aymaneelmaini.flywaytracker.actions.CreateMigrationAction"
                text="New Migration"
                description="Create a new Flyway migration file with auto-suggested version">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
        </action>

        <!-- Mark / unmark migration root: appears in directory context menu -->
        <action id="flyway.tracker.markAsRoot"
                class="com.aymaneelmaini.flywaytracker.actions.MarkAsMigrationRootAction"
                text="Migrations Root"
                description="Mark this directory as the Flyway migrations root">
            <add-to-group group-id="MarkRootGroup" anchor="last"/>
        </action>

        <action id="flyway.tracker.unmarkRoot"
                class="com.aymaneelmaini.flywaytracker.actions.UnMarkAsMigrationRootAction"
                text="Unmark as Migrations Root"
                description="Remove migrations root designation from this directory">
            <add-to-group group-id="MarkRootGroup" anchor="last"/>
        </action>

        <!-- Tools menu group -->
        <group id="flyway.tracker.toolsGroup"
               text="Flyway Tracker"
               description="Flyway Version Tracker actions"
               popup="true">

            <action id="flyway.tracker.configureBranch"
                    class="com.aymaneelmaini.flywaytracker.actions.ConfigureSyncBranchAction"
                    text="Configure Sync Branch"
                    description="Select the remote branch to check for migration version conflicts"/>

            <action id="flyway.tracker.refresh"
                    class="com.aymaneelmaini.flywaytracker.actions.RefreshMigrationsAction"
                    text="Refresh Migrations"
                    description="Fetch remote and reload migration data"/>

            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

    </actions>

</idea-plugin>
